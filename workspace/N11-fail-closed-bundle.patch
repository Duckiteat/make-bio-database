+      const a = hook(d, 'pre', { tool_name: name, tool_input: x });
+      assert.equal(a.status, 2, `${name}: 오류면 막힘`); assert.match(a.stderr, /fail-closed/);
+    }
+    assert.equal(hook(d, 'pre', { tool_name: 'mcp__biodb-query__summary', tool_input: {} }).status, 0, '읽기 전용 조회 서버는 열림');
