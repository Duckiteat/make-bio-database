+test('㉓ 문지기 오류 = 막힘 (N11 fail-closed · DEC-0093 ②): live 영수증에 깨진 줄 → 쓰는 도구 pre 는 2 · 읽기 전용 서버만 통과 · post 도 알림(2) · 설정의 훅 명령은 다른 종료 코드도 2 로', () => {
+  const d = repo();
+  try {
+    assert.equal(tool(d, 'Bash', { command: 'node rebuild/gate.mjs open develop' }).status, 0);
+    const r = RD(d), f = readdirSync(r).find((x) => x.endsWith('.jsonl'));
+    writeFileSync(join(r, f), readFileSync(join(r, f), 'utf8') + '{깨진 줄\n'); // 공격 재검토 N11 의 재현 — 전에는 모두 종료 0 ("통과시킴")
