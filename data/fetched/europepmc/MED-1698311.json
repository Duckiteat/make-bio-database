{"version":"6.9","hitCount":1,"request":{"queryString":"EXT_ID:1698311 AND SRC:MED","internalQuery":"EXT_ID:1698311 AND SRC:MED","resultType":"CORE","cursorMark":"*","pageSize":25,"sort":"","synonym":false},"resultList":{"result":[{"id":"1698311","source":"MED","pmid":"1698311","doi":"10.1126/science.1698311","title":"CD14, a receptor for complexes of lipopolysaccharide (LPS) and LPS binding protein.","authorString":"Wright SD, Ramos RA, Tobias PS, Ulevitch RJ, Mathison JC.","authorList":{"author":[{"fullName":"Wright SD","lastName":"Wright","firstName":"S D","initials":"SD","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Laboratory of Cellular Physiology and Immunology, Rockefeller University, New York, NY 10021."}]}},{"fullName":"Ramos RA","lastName":"Ramos","firstName":"R A","initials":"RA"},{"fullName":"Tobias PS","lastName":"Tobias","firstName":"P S","initials":"PS"},{"fullName":"Ulevitch RJ","lastName":"Ulevitch","firstName":"R J","initials":"RJ"},{"fullName":"Mathison JC","lastName":"Mathison","firstName":"J C","initials":"JC"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","related_data"]},"journalInfo":{"issue":"4975","volume":"249","journalIssueId":776695,"dateOfPublication":"1990 Sep","monthOfPublication":9,"yearOfPublication":1990,"journal":{"medlineAbbreviation":"Science","title":"Science (New York, N.Y.)","essn":"1095-9203","issn":"0036-8075","nlmid":"0404511","isoabbreviation":"Science"},"printPublicationDate":"1990-09-01"},"pubYear":"1990","pageInfo":"1431-1433","abstractText":"Leukocytes respond to lipopolysaccharide (LPS) at nanogram per milliliter concentrations with secretion of cytokines such as tumor necrosis factor-alpha (TNF-alpha). Excess secretion of TNF-alpha causes endotoxic shock, an often fatal complication of infection. LPS in the bloodstream rapidly binds to the serum protein, lipopolysaccharide binding protein (LBP), and cellular responses to physiological levels of LPS are dependent on LBP. CD14, a differentiation antigen of monocytes, was found to bind complexes of LPS and LBP, and blockade of CD14 with monoclonal antibodies prevented synthesis of TNF-alpha by whole blood incubated with LPS. Thus, LPS may induce responses by interacting with a soluble binding protein in serum that then binds the cell surface protein CD14.","affiliation":"Laboratory of Cellular Physiology and Immunology, Rockefeller University, New York, NY 10021.","publicationStatus":"ppublish","language":"eng","pubModel":"Print","pubTypeList":{"pubType":["Research Support, U.S. Gov't, P.H.S.","Research Support, Non-U.S. Gov't","Journal Article"]},"grantsList":{"grant":[{"agency":"NIAID NIH HHS","acronym":"AI","grantId":"AI 15136","orderIn":0},{"agency":"NIAID NIH HHS","acronym":"AI","grantId":"AI 22003","orderIn":0},{"agency":"NIAID NIH HHS","acronym":"AI","grantId":"AI 24775","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Erythrocytes","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"IM","qualifierName":"immunology"}]}},{"majorTopic_YN":"N","descriptorName":"Leukocytes","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"IM","qualifierName":"immunology"}]}},{"majorTopic_YN":"N","descriptorName":"Macrophages","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"IM","qualifierName":"immunology"}]}},{"majorTopic_YN":"N","descriptorName":"Animals"},{"majorTopic_YN":"N","descriptorName":"Sheep"},{"majorTopic_YN":"N","descriptorName":"Lipopolysaccharides","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"IM","qualifierName":"immunology"}]}},{"majorTopic_YN":"N","descriptorName":"Tumor Necrosis Factor-alpha","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"BI","qualifierName":"biosynthesis"}]}},{"majorTopic_YN":"Y","descriptorName":"Acute-Phase Proteins"},{"majorTopic_YN":"N","descriptorName":"Carrier Proteins","meshQualifierList":{"meshQualifie