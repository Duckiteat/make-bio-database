{"version":"6.9","hitCount":1,"request":{"queryString":"DOI:\"10.1126/science.7878466\"","resultType":"core","cursorMark":"*","pageSize":25,"sort":"","synonym":false},"resultList":{"result":[{"id":"7878466","source":"MED","pmid":"7878466","doi":"10.1126/science.7878466","title":"Control of I kappa B-alpha proteolysis by site-specific, signal-induced phosphorylation.","authorString":"Brown K, Gerstberger S, Carlson L, Franzoso G, Siebenlist U.","authorList":{"author":[{"fullName":"Brown K","lastName":"Brown","firstName":"K","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"National Institute of Allergy and Infectious Diseases, National Institutes of Health, Bethesda, MD 20892-1876."}]}},{"fullName":"Gerstberger S","lastName":"Gerstberger","firstName":"S","initials":"S"},{"fullName":"Carlson L","lastName":"Carlson","firstName":"L","initials":"L"},{"fullName":"Franzoso G","lastName":"Franzoso","firstName":"G","initials":"G","authorId":{"type":"ORCID","value":"0000-0002-0778-988X"}},{"fullName":"Siebenlist U","lastName":"Siebenlist","firstName":"U","initials":"U"}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-0778-988X"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","related_data"]},"journalInfo":{"issue":"5203","volume":"267","journalIssueId":850460,"dateOfPublication":"1995 Mar","monthOfPublication":3,"yearOfPublication":1995,"journal":{"medlineAbbreviation":"Science","title":"Science (New York, N.Y.)","essn":"1095-9203","issn":"0036-8075","isoabbreviation":"Science","nlmid":"0404511"},"printPublicationDate":"1995-03-01"},"pubYear":"1995","pageInfo":"1485-1488","abstractText":"I kappa B-alpha inhibits transcription factor NF-kappa B by retaining it in the cytoplasm. Various stimuli, typically those associated with stress or pathogens, rapidly inactivate I kappa B-alpha. This liberates NF-kappa B to translocate to the nucleus and initiate transcription of genes important for the defense of the organism. Activation of NF-kappa B correlates with phosphorylation of I kappa B-alpha and requires the proteolysis of this inhibitor. When either serine-32 or serine-36 of I kappa B-alpha was mutated, the protein did not undergo signal-induced phosphorylation or degradation, and NF-kappa B could not be activated. These results suggest that phosphorylation at one or both of these residues is critical for activation of NF-kappa B.","affiliation":"National Institute of Allergy and Infectious Diseases, National Institutes of Health, Bethesda, MD 20892-1876.","publicationStatus":"ppublish","language":"eng","pubModel":"Print","pubTypeList":{"pubType":["Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"T-Lymphocytes"},{"majorTopic_YN":"N","descriptorName":"Cell Line"},{"majorTopic_YN":"N","descriptorName":"Animals"},{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Mice"},{"majorTopic_YN":"N","descriptorName":"Tetradecanoylphorbol Acetate","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"PD","qualifierName":"pharmacology"}]}},{"majorTopic_YN":"N","descriptorName":"Ionomycin","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"PD","qualifierName":"pharmacology"}]}},{"majorTopic_YN":"N","descriptorName":"Tumor Necrosis Factor-alpha","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"PD","qualifierName":"pharmacology"}]}},{"majorTopic_YN":"N","descriptorName":"DNA-Binding Proteins","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"},{"majorTopic_YN":"Y","abbreviation":"ME","qualifierName":"metabolism"},{"majorTopic_YN":"N","abbreviation":"CH","qualifierName":"chemistry"}]}},{"majorTopic_YN":"N","descriptorName":"NF-kappa B","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"AI","qualifierName":"antagonists & inhibitors"},{"majorTopic_YN":"N","abbreviation":"ME","qua