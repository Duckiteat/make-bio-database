{"version":"6.9","hitCount":1,"request":{"queryString":"EXT_ID:11595186 AND SRC:MED","internalQuery":"EXT_ID:11595186 AND SRC:MED","resultType":"CORE","cursorMark":"*","pageSize":25,"sort":"","synonym":false},"resultList":{"result":[{"id":"11595186","source":"MED","pmid":"11595186","doi":"10.1016/s0092-8674(01)00504-9","title":"The shortest telomere, not average telomere length, is critical for cell viability and chromosome stability.","authorString":"Hemann MT, Strong MA, Hao LY, Greider CW.","authorList":{"author":[{"fullName":"Hemann MT","lastName":"Hemann","firstName":"M T","initials":"MT","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Molecular Biology and Genetics, Johns Hopkins University School of Medicine, Baltimore, MD 21205, USA."}]}},{"fullName":"Strong MA","lastName":"Strong","firstName":"M A","initials":"MA","authorId":{"type":"ORCID","value":"0000-0002-0055-6573"}},{"fullName":"Hao LY","lastName":"Hao","firstName":"L Y","initials":"LY"},{"fullName":"Greider CW","lastName":"Greider","firstName":"C W","initials":"CW","authorId":{"type":"ORCID","value":"0000-0002-5494-8126"}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-0055-6573"},{"type":"ORCID","value":"0000-0002-5494-8126"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","recommended_reviews","related_data","wikipedia"]},"journalInfo":{"issue":"1","volume":"107","journalIssueId":1017316,"dateOfPublication":"2001 Oct","monthOfPublication":10,"yearOfPublication":2001,"journal":{"medlineAbbreviation":"Cell","title":"Cell","essn":"1097-4172","issn":"0092-8674","isoabbreviation":"Cell","nlmid":"0413066"},"printPublicationDate":"2001-10-01"},"pubYear":"2001","pageInfo":"67-77","abstractText":"Loss of telomere function can induce cell cycle arrest and apoptosis. To investigate the processes that trigger cellular responses to telomere dysfunction, we crossed mTR-/- G6 mice that have short telomeres with mice heterozygous for telomerase (mTR+/-) that have long telomeres. The phenotype of the telomerase null offspring was similar to that of the late generation parent, although only half of the chromosomes were short. Strikingly, spectral karyotyping (SKY) analysis revealed that loss of telomere function occurred preferentially on chromosomes with critically short telomeres. Our data indicate that, while average telomere length is measured in most studies, it is not the average but rather the shortest telomeres that constitute telomere dysfunction and limit cellular survival in the absence of telomerase.","affiliation":"Department of Molecular Biology and Genetics, Johns Hopkins University School of Medicine, Baltimore, MD 21205, USA.","publicationStatus":"ppublish","language":"eng","pubModel":"Print","pubTypeList":{"pubType":["Research Support, U.S. Gov't, P.H.S.","Journal Article"]},"grantsList":{"grant":[{"agency":"NCI NIH HHS","acronym":"CA","grantId":"P01 CA16519","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Cells, Cultured"},{"majorTopic_YN":"N","descriptorName":"Chromosomes","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"PH","qualifierName":"physiology"}]}},{"majorTopic_YN":"N","descriptorName":"Telomere","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"ME","qualifierName":"metabolism"},{"majorTopic_YN":"Y","abbreviation":"PH","qualifierName":"physiology"},{"majorTopic_YN":"N","abbreviation":"UL","qualifierName":"ultrastructure"}]}},{"majorTopic_YN":"N","descriptorName":"Animals"},{"majorTopic_YN":"N","descriptorName":"Mice, Knockout"},{"majorTopic_YN":"N","descriptorName":"Mice"},{"majorTopic_YN":"N","descriptorName":"Telomerase","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"},{"majorTopic_YN":"Y","abbreviation":"ME","qualifierName":"metabolism"}]}},{"majorTopic_YN":"N","descriptorName":"In Situ Hybridization, Fluorescence"},{"majorTopic_YN":"N","descr