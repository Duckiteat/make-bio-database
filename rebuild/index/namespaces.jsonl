{"ns": "ext_go", "status": "external", "shape": "token", "pattern_from": "vocab.xrefs.GO.pattern", "examples": ["GO:0006099"], "issuer": "GO", "store": "data/db.json#senses.*.xrefs", "immutable": "external", "scan": false}
{"ns": "ext_reactome", "status": "external", "shape": "token", "pattern_from": "vocab.xrefs.Reactome.pattern", "examples": [], "issuer": "Reactome", "store": "data/db.json#senses.*.xrefs", "immutable": "external", "scan": false}
{"ns": "ext_kegg", "status": "external", "shape": "token", "pattern_from": "vocab.xrefs.KEGG.pattern", "examples": [], "issuer": "KEGG", "store": "data/db.json#senses.*.xrefs", "immutable": "external", "scan": false}
{"ns": "ext_ncbigene", "status": "external", "shape": "token", "pattern_from": "vocab.xrefs.NCBIGene.pattern", "examples": [], "issuer": "NCBIGene", "store": "data/db.json#senses.*.xrefs", "immutable": "external", "scan": false}
{"ns": "ext_cl", "status": "external", "shape": "token", "pattern_from": "vocab.xrefs.CL.pattern", "examples": [], "issuer": "CL", "store": "data/db.json#senses.*.xrefs", "immutable": "external", "scan": false}
{"ns": "ext_interpro", "status": "external", "shape": "token", "pattern_from": "vocab.xrefs.InterPro.pattern", "examples": [], "issuer": "InterPro", "store": "data/db.json#senses.*.xrefs", "immutable": "external", "scan": false}
{"ns": "ext_pmid", "status": "external", "shape": "token", "pattern_from": "vocab.xrefs.PMID.pattern", "examples": [], "issuer": "PMID", "store": "data/db.json#senses.*.xrefs", "immutable": "external", "scan": false}
{"ns": "ext_doi", "status": "external", "shape": "token", "pattern_from": "vocab.xrefs.DOI.pattern", "examples": [], "issuer": "DOI", "store": "data/db.json#senses.*.xrefs", "immutable": "external", "scan": false}
{"ns": "ext_pmc", "status": "external", "shape": "token", "pattern": "^PMC\\d+$", "examples": ["PMC1234567"], "issuer": "PubMed Central", "store": "evidence.sources / inbox", "immutable": "external", "scan": true, "note": "vocab.xrefs 에 없음"}
{"ns": "fp_inchikey", "status": "active", "shape": "composite", "pattern_from": "vocab.fingerprints.InChIKey.pattern", "examples": [], "issuer": "tool (computed)", "store": "data/db.json#senses.*.fingerprint", "immutable": "computed", "scan": false}
{"ns": "fp_seq_sha256", "status": "active", "shape": "composite", "pattern_from": "vocab.fingerprints.SEQ_SHA256.pattern", "examples": [], "issuer": "tool (computed)", "store": "data/db.json#senses.*.fingerprint", "immutable": "computed", "scan": false}
{"ns": "fp_complex", "status": "active", "shape": "composite", "pattern_from": "vocab.fingerprints.COMPLEX.pattern", "examples": [], "issuer": "tool (computed)", "store": "data/db.json#senses.*.fingerprint", "immutable": "computed", "scan": false}
{"ns": "ext_taxon", "status": "external", "shape": "vocab", "pattern": "^\\d+$", "examples": [], "issuer": "NCBI Taxonomy", "store": "vocab.taxa", "immutable": "external", "scan": false}
