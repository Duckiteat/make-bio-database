{"ns": "term", "status": "active", "shape": "token", "pattern_from": "model.ID_RE.T", "examples": ["T000001"], "issuer": "legislative merge (meta.next.T)", "store": "data/db.json#terms", "immutable": "no_reuse;moved", "scan": true, "defined_by": "db:terms"}
{"ns": "sense", "status": "active", "shape": "token", "pattern_from": "model.ID_RE.D", "examples": ["D000001"], "issuer": "legislative merge (meta.next.D)", "store": "data/db.json#senses", "immutable": "no_reuse;moved", "scan": true, "defined_by": "db:senses"}
{"ns": "step", "status": "active", "shape": "token", "pattern_from": "model.ID_RE.S", "examples": ["S000001"], "issuer": "legislative merge (meta.next.S)", "store": "data/db.json#steps", "immutable": "no_reuse;moved", "scan": true, "defined_by": "db:steps"}
{"ns": "limitation", "status": "active", "shape": "token", "pattern_from": "model.ID_RE.L", "examples": ["L000001"], "issuer": "legislative merge (meta.next.L)", "store": "data/db.json#limitations", "immutable": "no_reuse", "scan": true, "defined_by": "db:limitations"}
{"ns": "observation", "status": "active", "shape": "token", "pattern_from": "model.ID_RE.O", "examples": ["O000001"], "issuer": "legislative merge (meta.next.O)", "store": "data/db.json#observations", "immutable": "no_reuse;retract_only", "scan": true, "defined_by": "db:observations"}
{"ns": "value", "status": "active", "shape": "token", "pattern": "^V\\d{6}$", "examples": ["V000001"], "issuer": "legislative foldValues (meta.next.V)", "store": "data/db.json#values", "immutable": "no_reuse;supersede_only", "scan": true, "defined_by": "db:values", "note": "model.ID_RE 에 V 가 없음 — 형식이 fmtId 호출에만 있다"}
{"ns": "assumption", "status": "active", "shape": "token", "pattern": "^A\\d{6}$", "examples": ["A000001"], "issuer": "clerk appendAssumptions (seq)", "store": "data/assumptions.jsonl", "immutable": "append_only;revises", "scan": true, "defined_by": "jsonl:data/assumptions.jsonl:id", "note": "같은 정규식이 judicial/assumption_audit.js ID_RE 에 따로"}
{"ns": "temp_id", "status": "active", "shape": "token", "pattern": "^[TDSLOA]\\+[A-Za-z0-9_]+$", "examples": ["D+1", "T+gp", "O+1"], "issuer": "patch author (patch-local)", "store": "patch files (merge assigns real id)", "immutable": "patch_local", "scan": true, "note": "판정 model.isTemp"}
{"ns": "sub_ref", "status": "active", "shape": "composite", "pattern": "^D\\d{6}/(site|rule|desc|obs)/[A-Za-z0-9_]+$", "examples": ["D000044/site/reg_phos", "D000044/rule/a_form"], "issuer": "sense owner key", "store": "data/db.json#senses.*.site|rule|desc|obs", "immutable": "key_stable", "scan": false}
{"ns": "bundle_key", "status": "active", "shape": "composite", "pattern": "^D\\d{6}(\\|[a-z0-9_]+:[A-Za-z0-9_]+)*\\|[a-z_]+$", "examples": ["D000044|reg_phos:phosphorylated|cytosol", "D000039|cytosol"], "issuer": "derived (not issued)", "store": "computed from sense+site+location", "immutable": "derived", "scan": false}
{"ns": "event", "status": "active", "shape": "chain", "pattern": "^[1-9]\\d*$", "examples": [], "issuer": "clerk (seq, prev, root)", "store": "data/log/events.jsonl", "immutable": "append_only;hash_chain", "scan": false}
{"ns": "preregistration", "status": "active", "shape": "chain", "pattern": "^[1-9]\\d*$", "examples": [], "issuer": "clerk (seq, prev, root)", "store": "data/preregistrations.jsonl", "immutable": "append_only;hash_chain", "scan": false}
{"ns": "dictionary_entry", "status": "active", "shape": "chain", "pattern": "^[1-9]\\d*$", "examples": [], "issuer": "clerk (seq, prev, root)", "store": "data/dictionary.jsonl", "immutable": "append_only;hash_chain", "scan": false}
{"ns": "fetch_log", "status": "active", "shape": "chain", "pattern": "^[1-9]\\d*$", "examples": [], "issuer": "clerk (seq, prev, root)", "store": "data/fetched/*/FETCH_LOG.jsonl", "immutable": "append_only;hash_chain", "scan": false}
{"ns": "attestation", "status": "active", "shape": "chain", "pattern": "^[0-9a-f]{64}$", "examples": [], "issuer": "judicial attestation (digest)", "store": "attestations/registry.json", "immutable": "append_only;digest", "scan": false, "note": "도장 신원 = digest. claim verified|trend|accept"}
{"ns": "patch_record", "status": "active", "shape": "file", "pattern": "^\\d{8}-\\d{6}-.+\\.json$", "examples": [], "issuer": "clerk commitMerge", "store": "data/patches/", "immutable": "append_only", "scan": false}
{"ns": "vocab_token", "status": "active", "shape": "vocab", "examples": [], "issuer": "human (vocab.js, user request)", "store": "vocab.js", "immutable": "aliases;moved", "scan": false, "note": "뜻·영어는 data/dictionary.jsonl register/key — 번호 사전은 신원만"}
{"ns": "audit_code", "status": "active", "shape": "token", "pattern": "^AUDIT_[A-Z_]+$", "examples": ["AUDIT_MASS"], "issuer": "judicial (code literal)", "store": "judicial/*.js", "immutable": "stable", "scan": true, "members_from": "code:judicial"}
{"ns": "criterion", "status": "active", "shape": "token", "pattern": "^(S[0-4]|D[0-4]|T|I)\\.[a-z_]+$", "examples": ["S3.confirmed", "D2.estimate", "T.unchecked"], "issuer": "judicial/reliability.js CRITERIA", "store": "judicial/reliability.js#CRITERIA", "immutable": "stable", "scan": true, "scan_in": "md", "members_from": "reliability.CRITERIA"}
{"ns": "task", "status": "active", "shape": "token", "pattern": "^TASK-\\d{3}$", "examples": ["TASK-003"], "issuer": "integrator", "store": "workspace/tasks/", "immutable": "no_reuse", "scan": true, "defined_by": "files:workspace/tasks/TASK-*"}
{"ns": "ledger_unit", "status": "active", "shape": "token", "pattern": "^U\\d{4,}$", "examples": ["U0001"], "issuer": "classification (rebuild PLAN §5)", "store": "rebuild/ledger/*.jsonl", "immutable": "no_reuse", "scan": true}
{"ns": "scheduled_task", "status": "external", "shape": "token", "pattern": "^trig_[A-Za-z0-9]+$", "examples": ["trig_01F8u8Uv6zMLRRdiignASP1P"], "issuer": "claude.ai", "store": "claude.ai scheduled tasks", "immutable": "external", "scan": true}
{"ns": "inbox_file", "status": "active", "shape": "token", "pattern": "^(MED|PMC)-\\d+$", "examples": ["MED-7664836", "PMC-1234567"], "issuer": "clerk fetchToInbox (file stem)", "store": "data/fetched/europepmc/", "immutable": "evidence", "scan": true}
{"ns": "rule", "status": "active", "shape": "token", "pattern": "^RULE-\\d{4}$", "examples": ["RULE-0001"], "issuer": "rebuild 5 단계 (규칙 장부)", "store": "rebuild/rules/rules.jsonl", "immutable": "no_reuse", "scan": true, "note": "규칙 장부 — 판단으로 매긴 원래 규칙 단위마다 하나", "defined_by": "jsonl:rebuild/rules/rules.jsonl:id"}
{"ns": "decision", "status": "planned", "shape": "token", "pattern": "^DEC-\\d{4}$", "examples": ["DEC-0001"], "issuer": "(planned)", "store": "(planned)", "immutable": "no_reuse", "scan": true, "note": "사용자 결정"}
{"ns": "change", "status": "active", "shape": "token", "pattern": "^CHG-\\d{4}$", "examples": ["CHG-0001"], "issuer": "계산 — CHANGES.md 의 행을 아래(가장 오래된 행)부터 센 순번. 행은 맨 위에 더하기만 하므로 번호가 바뀌지 않는다", "store": "CHANGES.md", "immutable": "no_reuse", "scan": true, "note": "변경 기록 행. 연결은 anchor(그 행의 첫 칸)를 함께 적어 어긋나면 관리 파일 08 이 잡는다", "defined_by": "changes:CHANGES.md"}
{"ns": "code_head", "status": "active", "shape": "file", "pattern": "^code:[\\w./-]+\\.m?js$", "examples": ["code:judicial/fault.js"], "issuer": "— (파일 경로)", "store": "코드 파일 맨 위 주석 (계약·이유)", "immutable": "none", "scan": false, "note": "맥락 연결의 대상 — 그 파일의 머리 주석"}
{"ns": "plan_item", "status": "active", "shape": "token", "pattern": "^PLAN-(?:\\d{3}[ap]?|H\\d{2})$", "examples": ["PLAN-087", "PLAN-012a", "PLAN-050p", "PLAN-H01"], "issuer": "rebuild 6c (상태 기록 — 원래 순번에서 계산: 12A→a · 50′→p · (보류)→H)", "store": "rebuild/state/build-plan.jsonl", "immutable": "no_reuse", "scan": true, "note": "build-plan 항목 (지금 표의 순번 1–87)", "defined_by": "jsonl:rebuild/state/build-plan.jsonl:id"}
{"ns": "test", "status": "planned", "shape": "token", "pattern": "^TEST-\\d{4}$", "examples": ["TEST-0001"], "issuer": "(planned)", "store": "(planned)", "immutable": "no_reuse", "scan": true, "note": "시험 (지금 파일마다 ①부터)"}
{"ns": "switch", "status": "planned", "shape": "token", "pattern": "^SW-\\d{4}$", "examples": ["SW-0001"], "issuer": "(planned)", "store": "(planned)", "immutable": "no_reuse", "scan": true, "note": "전환 기록 (PLAN §3)"}
{"ns": "formula", "status": "active", "shape": "token", "pattern": "^EQ-\\d{4}$", "examples": ["EQ-0001"], "issuer": "rebuild 6d (수식 기록)", "store": "rebuild/rules/formulas.jsonl", "immutable": "no_reuse", "scan": true, "note": "수식 기록 (읽기 모드 L2)", "defined_by": "jsonl:rebuild/rules/formulas.jsonl:id"}
{"ns": "environment", "status": "planned", "shape": "token", "pattern": "^E\\d{6}$", "examples": ["E000001"], "issuer": "(planned)", "store": "(planned)", "immutable": "no_reuse", "scan": true, "note": "환경 조건 묶음 (build-plan 66)"}
{"ns": "feature_legacy", "status": "legacy", "shape": "token", "pattern": "^F\\d{6}$", "examples": ["F000012"], "issuer": "none (FEATURES.md 초안)", "store": "FEATURES.md (구현 안 됨)", "immutable": "none", "scan": true}
{"ns": "hypothesis_legacy", "status": "legacy", "shape": "token", "pattern": "^H\\d{6}$", "examples": ["H000003"], "issuer": "none (FEATURES.md 초안)", "store": "FEATURES.md (구현 안 됨)", "immutable": "none", "scan": true}
{"ns": "ext_uniprot", "status": "external", "shape": "token", "pattern_from": "vocab.xrefs.UniProt.pattern", "examples": ["P04637", "O75874", "Q9Y6K9"], "issuer": "UniProt", "store": "data/db.json#senses.*.xrefs", "immutable": "external", "scan": true}
{"ns": "ext_chebi", "status": "external", "shape": "token", "pattern_from": "vocab.xrefs.ChEBI.pattern", "examples": ["CHEBI:15422"], "issuer": "ChEBI", "store": "data/db.json#senses.*.xrefs", "immutable": "external", "scan": false}
