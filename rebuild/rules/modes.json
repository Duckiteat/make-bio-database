            "rule": "RULE-0515"
          }
        ],
        "finish": [
          "node dbtool.mjs validate"
        ]
      },
      "develop": {
        "write": [
          "**"
        ],
        "except": [
          "data/**",
          "attestations/**",
          "workspace/handoff/**"
        ],
        "deny": [
          {
            "re": "\\bdbtool\\.mjs\\s+(merge|augment\\s+(apply|fetch)|register)\\b",
            "why": "디벨롭은 기계를 고친다 — 데이터 넣기·사전 등록은 정보 작성·기초시험 세션에서",
            "rule": "RULE-0515"
          }
        ],
        "finish": [
          "node --test tests/*.test.mjs",
          "node dbtool.mjs validate",
          "node dbtool.mjs textbook --check"
        ]
      },
      "field": {
        "write": [
          "engine/**",
          "tests/**",
          "examples/scenarios/**",
          "docs/**",
          "schemas/ffi/**",
          "CHANGES.md"
        ],
        "deny": [
