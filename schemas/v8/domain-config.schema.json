{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmse/v8/domain-config.schema.json",
  "title": "DomainConfig — 영역 분할·점수·대리 모델 대체 설정 (형식 v8, 시나리오의 domains 필드)",
  "description": "참조 구현: engine/hmse.js validateDomainConfig. 데이터베이스(지식)가 아니라 실행 설정 — examples/scenarios/*.json 의 domains 에 둔다.",
  "type": "object",
  "required": ["domains", "metrics", "solver"],
  "properties": {
    "domains": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "tier", "location", "volume_fL"], "properties": {
      "id": { "type": "string" }, "tier": { "enum": ["T1", "T2", "T3"] }, "location": { "type": "string", "description": "vocab.js locations 키" },
      "volume_fL": { "type": "number", "exclusiveMinimum": 0 },
      "geometry_template": { "enum": ["box", "slab", "sphere", "spherical_shell", "cylinder"], "description": "T3 필수 — 정규화된 기준 경계 (FNO OOD 방지, 불변식 3)" },
      "grid": { "type": "object", "required": ["n", "h_m"], "properties": { "n": { "type": "integer", "minimum": 4 }, "h_m": { "type": "number", "exclusiveMinimum": 0 } } } },
      "if": { "properties": { "tier": { "const": "T3" } } }, "then": { "required": ["geometry_template", "grid"] } } },
    "adjacency": { "type": "array", "items": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 } },
    "metrics": { "type": "object", "required": ["w1", "w2", "tau_high", "tau_low", "t_min"], "properties": {
      "w1": { "type": "number", "minimum": 0, "description": "가중치 · ⟨|∇²C|⟩" }, "w2": { "type": "number", "minimum": 0, "description": "가중치 · ∂S_spatial/∂t" },
      "tau_high": { "type": "number", "exclusiveMinimum": 0 }, "tau_low": { "type": "number", "minimum": 0, "description": "< tau_high (히스테리시스)" },
      "t_min": { "type": "number", "exclusiveMinimum": 0, "description": "최소 체류 시간 (s) — 깜빡임 방지" },
      "gp_length_scale_m": { "type": "number", "exclusiveMinimum": 0, "description": "승격 시 GPR 평활 길이" } } },
    "solver": { "type": "object", "required": ["epsilon_max", "fallback", "window_min_s"], "properties": {
      "epsilon_max": { "type": "number", "exclusiveMinimum": 0 }, "fallback": { "const": "fv3d" },
      "window_min_s": { "type": "number", "exclusiveMinimum": 0, "description": "비동기 대체 계산의 최소 보수적 시간 창" },
      "async_fallback": { "type": "boolean", "default": true }, "cle_threshold": { "type": "number", "minimum": 0, "description": "이 분자 수 이상이면 CLE (Tier 1 강성 처리)" } } }
  }
}
