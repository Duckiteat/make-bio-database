{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmse/v8/ledger-transaction.schema.json",
  "title": "LedgerTransaction — Adjacent Boundary Transaction (형식 v8, 불변식 1)",
  "description": "두 인접 영역 원장 사이의 정수 이동. 두 원장만 잠근다(낙관적 버전). 참조 구현: engine/hmse.js validateLedgerTx·applyLedgerTx.",
  "type": "object",
  "required": ["from", "to", "seq", "t", "base_version", "items"],
  "additionalProperties": false,
  "properties": {
    "from": { "type": "string", "minLength": 1 },
    "to": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 1, "description": "영역 쌍마다 단조 증가 — 멱등 적용 키" },
    "t": { "type": "number", "minimum": 0, "description": "DEVS 시각 (s)" },
    "base_version": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 }, "minProperties": 2, "maxProperties": 2 },
    "items": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["key", "dn"], "additionalProperties": false,
      "properties": { "key": { "type": "string", "description": "v7 묶음 키 D…|부위:특징|위치" }, "dn": { "type": "integer", "not": { "const": 0 }, "description": "> 0: from → to" } } } },
    "residual": { "type": "object", "additionalProperties": { "type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 1 }, "description": "나머지 이월 모드의 소수 나머지 (|r| < 1)" },
    "pending": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 }, "description": "원장 부족으로 다음 창에 넘긴 정수" },
    "mode": { "enum": ["stochastic", "residual"] },
    "cause": { "type": "string", "description": "원인 패킷 id (BoundaryFluxPacket region:node:seq)" }
  }
}
